<?xml version="1.0" encoding="utf-8"?>
<!-- 底部导航栏：主页 / 购物车 / 个人中心（三个页签共用同一份布局） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <!-- 主页 -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="主页"
                android:src="@drawable/ic_nav_home" />

            <TextView
                android:id="@+id/nav_home_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="主页"
                android:textColor="@color/nav_unselected"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 购物车 -->
        <LinearLayout
            android:id="@+id/nav_cart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/nav_cart_icon"
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:contentDescription="购物车"
                    android:src="@drawable/ic_nav_cart" />

                <TextView
                    android:id="@+id/tv_nav_cart_badge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-6dp"
                    android:layout_marginEnd="-8dp"
                    android:background="@drawable/shape_badge"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/nav_cart_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="购物车"
                android:textColor="@color/nav_unselected"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 个人中心 -->
        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_profile_icon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="个人中心"
                android:src="@drawable/ic_nav_profile" />

            <TextView
                android:id="@+id/nav_profile_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="个人中心"
                android:textColor="@color/nav_unselected"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
