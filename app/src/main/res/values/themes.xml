<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.Light.NoActionBar">
        <!-- 页面背景统一为浅色，状态栏使用深色图标，避免与浅色标题区分不清 -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorSecondary">@color/brand_dark</item>
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />
</resources>
